<Project>
  <!--
    Central package management: every package version is pinned here, and project files reference
    packages without a version. Allowed licenses and the notice list: agents/conventions.md and
    THIRD-PARTY-NOTICES.md.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
